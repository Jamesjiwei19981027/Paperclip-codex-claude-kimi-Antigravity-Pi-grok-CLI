+  it.each(["192.168.0.213:3100", "http://host/path", "http://host/path/..", "http://host/.", "http://host?key=x", "http://host/#x", "http://user:pass@host", "ws://host", "http://host/?", "http://host/#", " http://host", "http://host\\path"])("拒绝非纯 HTTP(S) 源地址 %s", (serverUrl) => {
