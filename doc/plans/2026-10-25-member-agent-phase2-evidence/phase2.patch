index 0000000..ac7c74f
--- /dev/null
+++ b/member-agent/src/job-runner.ts
@@ -0,0 +1,101 @@
+import { Worker } from 'node:worker_threads';
+import { StringDecoder } from 'node:string_decoder';
+import type { Logger } from './logger.ts';
+import { chunkUtf8, validateEvent, validateResult } from './protocol.ts';
+import type { Frame, JobStart } from './protocol.ts';
+import type { ExecutorResult } from './executors/types.ts';
+
+interface ActiveJob{
+ job:JobStart;worker:Worker|null;logSeq:number;eventSeq:number;suppressed:boolean;stopping:boolean;timedOut:boolean;
+ result:ExecutorResult|null;timer:ReturnType<typeof setTimeout>|null;stopTimer:ReturnType<typeof setTimeout>|null;
+ done:Promise<void>;resolve:()=>void;finishing:boolean;
+}
+export class JobRunner{
+ private active:ActiveJob|null=null;
+ private accepting=true;
+ private send:(frame:Frame)=>void;
+ private options:{serverUrl:string;logger:Logger;executorUrl?:URL;executorData?:unknown;echoHoldSec?:number};
+ constructor(options:{serverUrl:string;logger:Logger;send:(frame:Frame)=>void;executorUrl?:URL;executorData?:unknown;echoHoldSec?:number}){this.options=options;this.send=options.send;}
+ get busy(){return this.active!==null;}
+ setSender(send:(frame:Frame)=>void){this.send=send;}
+ private safe(value:unknown):any{
+  if(typeof value==='string')return this.options.logger.redactor.redact(value);
+  if(Array.isArray(value))return value.map(item=>this.safe(item));
+  if(value!==null&&typeof value==='object')return Object.fromEntries(Object.entries(value).map(([key,item])=>[this.options.logger.redactor.redact(key),this.safe(item)]));
+  return value;
+ }
+ start(job:JobStart){
+  if(!this.accepting)return;
+  this.options.logger.redactor.register(job.authToken,job.runtimeTools?.bearerToken);
+  if(this.active){this.send(this.safe({v:1,type:'job.result',jobId:job.jobId,exitCode:1,signal:null,timedOut:false,errorCode:'member_agent_busy',errorMessage:'成员代理正在执行其他任务'}));return;}
+  let resolve!:()=>void;const done=new Promise<void>(r=>{resolve=r;});
+  const active:ActiveJob={job,worker:null,logSeq:0,eventSeq:0,suppressed:false,stopping:false,timedOut:false,result:null,timer:null,stopTimer:null,done,resolve,finishing:false};
+  this.active=active;
+  // Confirm receipt before module loading, worker creation, or any executor preparation.
+  try{
+   this.send({v:1,type:'job.accepted',jobId:job.jobId});
+   this.options.logger.write('info',`收到任务 ${job.jobId}`,true);
+   const worker=new Worker(new URL('./executor-worker.ts',import.meta.url),{workerData:{job,serverUrl:this.options.serverUrl,executorUrl:(this.options.executorUrl??new URL('./executors/echo.ts',import.meta.url)).href,executorData:this.options.executorData,echoHoldSec:this.options.echoHoldSec??0},stdout:true,stderr:true,execArgv:[]});
+   active.worker=worker;
+   for(const [stream,pipe] of [['stdout',worker.stdout],['stderr',worker.stderr]] as const){
+    const decoder=new StringDecoder('utf8');
+    pipe?.on('data',data=>this.log(active,stream,decoder.write(data)));
+    pipe?.on('end',()=>this.log(active,stream,decoder.end()));
+   }
+   worker.on('message',message=>{
+    if(this.active!==active||active.finishing||active.suppressed)return;
+    try{
+     if(message.type==='log'&&['stdout','stderr'].includes(message.stream)&&typeof message.text==='string')this.log(active,message.stream,message.text);
+     else if(message.type==='event'){const event=validateEvent(message.event);this.send(this.safe({v:1,type:'job.event',jobId:job.jobId,seq:++active.eventSeq,event}));}
+     else if(message.type==='result'){active.result=validateResult(message.result);void worker.terminate();}
+    }catch{active.result={exitCode:1,signal:null,timedOut:false,errorCode:'member_agent_executor_error',errorMessage:'执行器返回了无效协议字段'};void worker.terminate();}
+   });
+   worker.on('error',()=>{active.result={exitCode:1,signal:null,timedOut:false,errorCode:'member_agent_executor_error',errorMessage:'执行器线程发生内部错误，请检查程序文件'};});
+   worker.on('exit',()=>{void this.finish(active);});
+   const maxRunSec=job.config?.maxRunSec??3600;
+   active.timer=setTimeout(()=>{void this.stop(active,20,true);},maxRunSec*1000);
+  }catch{active.result={exitCode:1,signal:null,timedOut:false,errorCode:'member_agent_executor_error',errorMessage:'无法启动执行器，请检查 Node 版本与程序文件'};void this.finish(active);}
+ }
+ private log(active:ActiveJob,stream:'stdout'|'stderr',text:string){
+  if(active.suppressed||active.finishing)return;
+  const safe=this.options.logger.redactor.chunk(`${active.job.jobId}:${stream}`,text);
+  if(!safe)return;
+  this.options.logger.write(stream==='stderr'?'warn':'info',safe);
+  for(const chunk of chunkUtf8(safe))this.send({v:1,type:'job.log',jobId:active.job.jobId,seq:++active.logSeq,stream,chunk});
+ }
+ private async finish(active:ActiveJob){
+  if(active.finishing)return;active.finishing=true;
+  let resultSent=false;
+  if(active.timer)clearTimeout(active.timer);if(active.stopTimer)clearTimeout(active.stopTimer);
+  try{
+  for(const stream of ['stdout','stderr']){
+   const safe=this.options.logger.redactor.finish(`${active.job.jobId}:${stream}`);
+   if(safe&&!active.suppressed){this.options.logger.write('info',safe);for(const chunk of chunkUtf8(safe))this.send({v:1,type:'job.log',jobId:active.job.jobId,seq:++active.logSeq,stream,chunk});}
+  }
+  let result=active.result??{exitCode:1,signal:null,timedOut:false,errorCode:'member_agent_executor_error',errorMessage:'执行器未返回结果'};
+  if(active.stopping)result={exitCode:1,signal:null,timedOut:active.timedOut,errorCode:active.timedOut?'member_agent_timeout':'cancelled',errorMessage:active.timedOut?'任务超过本机时长上限':'任务已取消'};
+  this.options.logger.write('info',`任务结束 ${active.job.jobId}：${result.exitCode===0?'成功':result.errorCode??'失败'}`,true);
+  if(!active.suppressed){const frame=this.safe({v:1,type:'job.result',jobId:active.job.jobId,...validateResult(result)});resultSent=true;this.send(frame);}
+  }catch{
+   if(!active.suppressed&&!resultSent){try{this.send({v:1,type:'job.result',jobId:active.job.jobId,exitCode:1,signal:null,timedOut:false,errorCode:'member_agent_executor_error',errorMessage:'任务收尾失败，请检查本机日志目录与连接'});}catch{/* The connection owns transport error handling. */}}
+  }finally{if(this.active===active)this.active=null;active.resolve();}
+ }
+ private stop(active:ActiveJob,graceSec:number,timedOut=false){
+  if(active.finishing||active.stopping)return active.done;
+  active.stopping=true;active.timedOut=timedOut;
+  if(!active.worker){void this.finish(active);return active.done;}
+  active.worker?.postMessage({type:'cancel'});
+  active.stopTimer=setTimeout(()=>{void active.worker?.terminate().then(()=>this.finish(active));},Math.max(0,graceSec)*1000);
+  return active.done;
+ }
+ async cancel(jobId:string,graceSec=20){
+  if(!this.active||this.active.job.jobId!==jobId){this.options.logger.write('warn','忽略不属于当前任务的取消请求');return;}
+  await this.stop(this.active,graceSec);
+ }
+ async disconnect(){
+  if(!this.active)return;const active=this.active;active.suppressed=true;
+  try{this.options.logger.write('warn',`连接断开，已中止任务 ${active.job.jobId}`,true);}finally{await this.stop(active,20);}
+ }
+ async shutdown(){this.accepting=false;if(this.active)await this.stop(this.active,20);}
+ force(){this.accepting=false;if(this.active){this.active.suppressed=true;void this.active.worker?.terminate();}}
+}
diff --git a/member-agent/src/lock.ts b/member-agent/src/lock.ts
new file mode 100644
index 0000000..340bb70
--- /dev/null
+++ b/member-agent/src/lock.ts
@@ -0,0 +1,88 @@
+import { randomUUID } from "node:crypto";
+import { link, mkdir, readFile, stat, unlink, writeFile } from "node:fs/promises";
+import path from "node:path";
+
+export class LockError extends Error {
+  readonly code = 5;
+  constructor(message: string) { super(message); this.name = "LockError"; }
+}
+
+function isLive(pid: number): boolean {
+  try { process.kill(pid, 0); return true; }
+  catch (error) { return (error as NodeJS.ErrnoException).code !== "ESRCH"; }
+}
+
+function livePid(text: string): number | undefined {
+  const pid = /^\d+$/.test(text.trim()) ? Number(text.trim()) : NaN;
+  return Number.isSafeInteger(pid) && pid > 0 && isLive(pid) ? pid : undefined;
+}
+
+async function unlinkIfSame(file: string, identity: { ino: number; birthtimeMs: number }): Promise<void> {
+  try {
+    const now = await stat(file);
+    if (now.ino === identity.ino && now.birthtimeMs === identity.birthtimeMs) await unlink(file);
+  } catch (error) { if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error; }
+}
+
+// Serialize stale-lock replacement within the process as well as exclusive creation
+// across processes. The exclusive recovery file protects cross-process reclamation.
+const pendingAcquisitions = new Map<string, Promise<void>>();
+
+export async function acquireLock(dir: string): Promise<() => Promise<void>> {
+  await mkdir(dir, { recursive: true });
+  const lockPath = path.resolve(dir, "agent.lock");
+  const previous = pendingAcquisitions.get(lockPath) ?? Promise.resolve();
+  let complete!: () => void;
+  const current = new Promise<void>((resolve) => { complete = resolve; });
+  pendingAcquisitions.set(lockPath, current);
+  await previous;
+  try {
+    const recoveryPath = lockPath + ".recovery";
+    // Link a fully written PID file so other processes never observe an empty
+    // lock between exclusive creation and writing its owner PID.
+    const stagingPath = lockPath + `.${process.pid}.${randomUUID()}.tmp`;
+    await writeFile(stagingPath, String(process.pid), { encoding: "utf8", flag: "wx" });
+    const stagingIdentity = await stat(stagingPath);
+    let acquired = false;
+    try {
+      for (let attempt = 0; attempt < 3; attempt++) {
+        try { await link(stagingPath, recoveryPath); acquired = true; break; }
+        catch (error) {
+          if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
+          try {
+            const identity = await stat(recoveryPath);
+            const pid = livePid(await readFile(recoveryPath, "utf8"));
+            if (pid) throw new LockError(`已有代理正在获取本机锁（进程号 ${pid}），请稍后重试。`);
+            await unlinkIfSame(recoveryPath, identity);
+          } catch (readError) { if ((readError as NodeJS.ErrnoException).code !== "ENOENT") throw readError; }
+        }
+      }
+      if (!acquired) throw new LockError("已有代理正在获取本机锁，请稍后重试。");
+      let existing: string | undefined;
+      try { existing = await readFile(lockPath, "utf8"); }
+      catch (error) { if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error; }
+      if (existing !== undefined) {
+        const pid = livePid(existing);
+        if (pid) throw new LockError(`已有代理在运行（进程号 ${pid}），请先退出另一个实例。`);
+        await unlink(lockPath);
+      }
+      await link(stagingPath, lockPath);
+      const identity = await stat(lockPath);
+      let released = false;
+      return async () => {
+        if (released) return;
+        released = true;
+        try {
+          const now = await stat(lockPath);
+          if (now.ino === identity.ino && now.birthtimeMs === identity.birthtimeMs && (await readFile(lockPath, "utf8")) === String(process.pid)) await unlink(lockPath);
+        } catch (error) { if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error; }
+      };
+    } finally {
+      try { if (acquired) await unlinkIfSame(recoveryPath, stagingIdentity); }
+      finally { await unlink(stagingPath); }
+    }
+  } finally {
+    complete();
+    if (pendingAcquisitions.get(lockPath) === current) pendingAcquisitions.delete(lockPath);
+  }
+}
diff --git a/member-agent/src/logger.ts b/member-agent/src/logger.ts
new file mode 100644
index 0000000..2f9ba6f
--- /dev/null
+++ b/member-agent/src/logger.ts
@@ -0,0 +1,89 @@
+import { appendFileSync, mkdirSync, readdirSync, unlinkSync } from "node:fs";
+import path from "node:path";
+
+function mask(secret: string): string {
+  // A very short credential must never be reproduced in full.
+  return secret.slice(0, Math.min(4, secret.length - 1)) + "…";
+}
+
+/** One shared redactor is used for local output and outgoing job output. */
+export class Redactor {
+  private variants = new Map<string, string>();
+  private pending = new Map<string, string>();
+  private ordered: [string, string][] = [];
+
+  register(...secrets: unknown[]): void {
+    for (const secret of secrets) {
+      if (typeof secret !== "string" || secret.length === 0) continue;
+      const forms = new Set([secret, JSON.stringify(secret).slice(1, -1)]);
+      try {
+        forms.add(encodeURIComponent(secret));
+        forms.add(encodeURI(secret));
+        forms.add(new URLSearchParams({ value: secret }).toString().slice(6));
+      } catch { /* Invalid Unicode is still protected as plain and JSON text. */ }
+      for (const form of [...forms]) forms.add(form.replace(/%[0-9A-F]{2}/g, (part) => part.toLowerCase()));
+      for (const form of forms) this.variants.set(form, mask(secret));
+    }
+    this.ordered = [...this.variants].sort(([a], [b]) => b.length - a.length);
+  }
+
+  private scan(text: string, streaming: boolean): { output: string; pending: string } {
+    let output = "";
+    let index = 0;
+    while (index < text.length) {
+      const match = this.ordered.find(([variant]) => text.startsWith(variant, index));
+      if (match) { output += match[1]; index += match[0].length; continue; }
+      const remaining = text.slice(index);
+      if (streaming && this.ordered.some(([variant]) => variant.startsWith(remaining))) return { output, pending: remaining };
+      output += text[index]; index++;
+    }
+    return { output, pending: "" };
+  }
+
+  redact(text: string): string { return this.scan(text, false).output; }
+
+  chunk(stream: string, text: string): string {
+    const result = this.scan((this.pending.get(stream) ?? "") + text, true);
+    if (result.pending) this.pending.set(stream, result.pending);
+    else this.pending.delete(stream);
+    return result.output;
+  }
+
+  finish(stream: string): string {
+    const pending = this.pending.get(stream);
+    this.pending.delete(stream);
+    // An incomplete secret at EOF is never flushed as ordinary text.
+    return pending ? "…" : "";
+  }
+}
+
+function dayName(date: Date): string {
+  return `${date.getFullYear()}${String(date.getMonth() + 1).padStart(2, "0")}${String(date.getDate()).padStart(2, "0")}`;
+}
+
+export class Logger {
+  readonly redactor = new Redactor();
+  private dir: string;
+  private consoleSink: (text: string) => void;
+
+  constructor(dir: string, secrets: string[] = [], consoleSink: (text: string) => void = console.log) {
+    this.dir = dir;
+    this.consoleSink = consoleSink;
+    this.redactor.register(...secrets);
+    mkdirSync(dir, { recursive: true });
+    const oldest = new Date(); oldest.setHours(0, 0, 0, 0); oldest.setDate(oldest.getDate() - 6);
+    const threshold = dayName(oldest);
+    for (const entry of readdirSync(dir, { withFileTypes: true })) {
+      const match = /^agent-(\d{8})\.log$/.exec(entry.name);
+      if (entry.isFile() && match && match[1]! < threshold) unlinkSync(path.join(dir, entry.name));
+    }
+  }
+
+  write(level: "info" | "warn" | "error" | "debug", message: string, visible = false): void {
+    const safe = this.redactor.chunk("local-log", String(message)).replace(/\r/g, "\\r").replace(/\n/g, "\\n");
+    const now = new Date();
+    const line = `${now.toISOString()} ${level.toUpperCase()} ${safe}`;
+    appendFileSync(path.join(this.dir, `agent-${dayName(now)}.log`), line + "\n", "utf8");
+    if (visible) this.consoleSink(line);
+  }
+}
diff --git a/member-agent/src/main.ts b/member-agent/src/main.ts
new file mode 100644
index 0000000..ab7a227
--- /dev/null
+++ b/member-agent/src/main.ts
@@ -0,0 +1,57 @@
+import { join, resolve } from 'node:path';
+import { homedir } from 'node:os';
+import { pathToFileURL } from 'node:url';
+import type { EventEmitter } from 'node:events';
+import { loadConfig } from './config.ts';
+import { assertTransportAllowed } from './transport-check.ts';
+import { acquireLock } from './lock.ts';
+import { Logger } from './logger.ts';
+import { connectLoop } from './connection.ts';
+import { JobRunner } from './job-runner.ts';
+import { AGENT_VERSION } from './executors/echo.ts';
+import type { JobStart } from './protocol.ts';
+
+export function installInterrupts(signals:Pick<EventEmitter,'on'|'off'>,runner:{shutdown:()=>Promise<void>;force:()=>void},close:()=>void|Promise<void>,exit:(code:number)=>void){
+ let count=0;
+ const handle=()=>{if(++count>1){runner.force();exit(0);return;}void runner.shutdown().catch(()=>{}).then(close).catch(()=>{});};
+ signals.on('SIGINT',handle);
+ return ()=>{signals.off('SIGINT',handle);};
+}
+const usage='用法：node member-agent/src/main.ts run|check [--config <文件>]，或 version';
+export async function main(args=process.argv.slice(2)):Promise<number>{
+ const command=args[0];let configPath:string|undefined;
+ if(!['run','check','version'].includes(command)|| (command==='version'&&args.length!==1)){console.error(usage);return 2;}
+ for(let i=1;i<args.length;i++){if(args[i]!=='--config'||!args[i+1]||configPath!==undefined){console.error(usage);return 2;}configPath=args[++i];}
+ if(command==='version'){console.log(AGENT_VERSION);return 0;}
+ const stateDir=join(process.env.APPDATA??join(homedir(),'AppData','Roaming'),'paperclip-member-agent');
+ const warnings:string[]=[];
+ let release:(()=>Promise<void>)|undefined;
+ let logger:Logger|undefined;
+ try{
+  const config=await loadConfig(configPath,process.env,message=>warnings.push(message));
+  logger=new Logger(join(stateDir,'logs'),[config.agentKey]);
+  for(const warning of warnings)logger.write('warn',warning,true);
+  release=await acquireLock(stateDir);
+  assertTransportAllowed(config.serverUrl);
+  const stop=new AbortController();
+  let drain:()=>Promise<boolean>=async()=>true;
+  const runner=new JobRunner({serverUrl:config.serverUrl,logger,send:()=>{},echoHoldSec:config.echoHoldSec});
+  const dispose=installInterrupts(process,runner,async()=>{
+   try{if(!await drain())logger!.write('warn','退出前结果未能送达服务器，请在看板核对本次运行',true);}finally{stop.abort();}
+  },code=>process.exit(code));
+  try{
+   return await connectLoop({serverUrl:config.serverUrl,agentKey:config.agentKey,version:AGENT_VERSION,check:command==='check',signal:stop.signal,logger,
+    onSession:(send,flush)=>{runner.setSender(send);drain=flush;},onDisconnect:()=>runner.disconnect(),onFrame:frame=>{
+     if(stop.signal.aborted)return;
+     if(frame.type==='job.start')runner.start(frame as unknown as JobStart);
+     else if(frame.type==='job.cancel')return runner.cancel(String(frame.jobId),typeof frame.graceSec==='number'&&Number.isFinite(frame.graceSec)&&frame.graceSec>=0?Math.min(frame.graceSec,20):20);
+    }});
+  }finally{dispose();await runner.shutdown();}
+ }catch(error){
+  const code=typeof error==='object'&&error!==null&&'code'in error&&[2,5].includes(Number(error.code))?Number(error.code):1;
+  const message=error instanceof Error?error.message:'成员代理发生内部错误，请查看日志';
+  if(logger)logger.write('error',message,true);else console.error(message);
+  return code;
+ }finally{await release?.();}
+}
+if(process.argv[1]&&import.meta.url===pathToFileURL(resolve(process.argv[1])).href){void main().then(code=>{process.exitCode=code;}).catch(()=>{console.error('成员代理发生内部错误，请检查配置和日志');process.exitCode=1;});}
diff --git a/member-agent/src/outbound-queue.ts b/member-agent/src/outbound-queue.ts
new file mode 100644
index 0000000..256e94b
--- /dev/null
+++ b/member-agent/src/outbound-queue.ts
@@ -0,0 +1,104 @@
+import type { Frame } from './protocol.ts';
+
+export interface QueueSocket {
+  readonly readyState: number;
+  readonly bufferedAmount: number;
+  send(data: string, callback: (error?: Error) => void): void;
+}
+interface QueuedFrame { data: string; bytes: number; log: boolean }
+interface QueueOptions {
+  onDrop?: (count: number) => void;
+  onError?: (error: Error) => void;
+  clock?: Pick<import('./connection.ts').Clock, 'setTimeout' | 'clearTimeout'>;
+}
+
+/** At most one ws send is outstanding; only log frames may be evicted. */
+export class OutboundQueue {
+  private readonly socket: QueueSocket;
+  private readonly options: QueueOptions;
+  private pending: QueuedFrame[] = [];
+  private bytes = 0;
+  private inFlight: QueuedFrame | undefined;
+  private stopped = false;
+  private timer: ReturnType<typeof setTimeout> | undefined;
+  private drainWaiters = new Set<(success: boolean) => void>();
+  private readonly clock: Pick<import('./connection.ts').Clock, 'setTimeout' | 'clearTimeout'>;
+  constructor(socket: QueueSocket, options: QueueOptions = {}) {
+    this.socket = socket;
+    this.options = options;
+    this.clock = options.clock ?? { setTimeout, clearTimeout };
+  }
+  send(frame: Frame): void {
+    if (this.stopped) return;
+    const data = JSON.stringify(frame);
+    const item = { data, bytes: Buffer.byteLength(data), log: frame.type === 'job.log' };
+    if (item.bytes > 256 * 1024) throw new Error('发送帧超过 256 KB');
+    this.pending.push(item);
+    this.bytes += item.bytes;
+    let dropped = 0;
+    while (this.pending.length + (this.inFlight ? 1 : 0) > 1000 || this.bytes + (this.inFlight?.bytes ?? 0) > 8 * 1024 * 1024) {
+      const index = this.pending.findIndex(value => value.log);
+      if (index < 0) {
+        // Critical frames are never silently lost. Fail the session if its
+        // producer violates the finite single-job transport budget.
+        this.close();
+        throw new Error('关键消息队列超过上限，连接必须中止');
+      }
+      const [removed] = this.pending.splice(index, 1);
+      this.bytes -= removed!.bytes;
+      dropped++;
+    }
+    if (dropped) this.options.onDrop?.(dropped);
+    this.flush();
+  }
+  private flush(): void {
+    if (this.stopped || this.inFlight || this.pending.length === 0 || this.socket.readyState !== 1) return;
+    if (this.socket.bufferedAmount >= 256 * 1024) {
+      // ws has no drain event. A bounded timer is only needed when its existing
+      // buffer was filled outside this queue; ordinary draining uses callbacks.
+      this.timer ??= this.clock.setTimeout(() => { this.timer = undefined; this.flush(); }, 50);
+      return;
+    }
+    const item = this.pending.shift()!;
+    this.bytes -= item.bytes;
+    this.inFlight = item;
+    try {
+      this.socket.send(item.data, error => {
+        if (this.stopped) return;
+        this.inFlight = undefined;
+        if (error) { this.close(); this.options.onError?.(error); return; }
+        this.flush();
+        if (!this.inFlight && this.pending.length === 0) {
+          for (const finish of [...this.drainWaiters]) finish(true);
+        }
+      });
+    } catch (error) {
+      this.close();
+      this.options.onError?.(error instanceof Error ? error : new Error('消息发送失败'));
+    }
+  }
+  /** Wait for ws send callbacks, bounded so shutdown cannot hang indefinitely. */
+  drain(timeoutMs = 5000): Promise<boolean> {
+    if (this.stopped) return Promise.resolve(false);
+    if (!this.inFlight && this.pending.length === 0) return Promise.resolve(true);
+    return new Promise(resolve => {
+      const finish = (success: boolean) => {
+        if (!this.drainWaiters.delete(finish)) return;
+        this.clock.clearTimeout(timer);
+        resolve(success);
+      };
+      const boundedMs = Number.isFinite(timeoutMs) ? Math.max(0, Math.min(timeoutMs, 5000)) : 5000;
+      const timer = this.clock.setTimeout(() => finish(false), boundedMs);
+      this.drainWaiters.add(finish);
+    });
+  }
+  close(): void {
+    this.stopped = true;
+    this.pending = [];
+    this.bytes = 0;
+    this.inFlight = undefined;
+    if (this.timer !== undefined) this.clock.clearTimeout(this.timer);
+    this.timer = undefined;
+    for (const finish of [...this.drainWaiters]) finish(false);
+  }
+}
diff --git a/member-agent/src/process-tree.ts b/member-agent/src/process-tree.ts
new file mode 100644
index 0000000..0c02cd6
--- /dev/null
+++ b/member-agent/src/process-tree.ts
@@ -0,0 +1,25 @@
+import { execFile } from "node:child_process";
+import { promisify } from "node:util";
+
+const execFileAsync = promisify(execFile);
+
+function processExists(pid: number): boolean {
+  try { process.kill(pid, 0); return true; }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === "ESRCH") return false; throw new Error(`无法确认进程 ${pid} 是否已退出。`); }
+}
+
+/** Call only for child PIDs tracked by the executor, never for server-supplied IDs. */
+export async function terminateProcessTree(pid: number): Promise<void> {
+  if (!Number.isSafeInteger(pid) || pid <= 0 || pid === process.pid) throw new Error("进程号无效，不能终止进程树。");
+  if (process.platform !== "win32") throw new Error("本阶段仅支持 Windows 进程树终止。");
+  if (!processExists(pid)) return;
+  try {
+    await execFileAsync("taskkill.exe", ["/PID", String(pid), "/T", "/F"], { windowsHide: true, timeout: 5_000, encoding: "utf8" });
+  } catch { throw new Error(`无法终止进程树 ${pid}：taskkill 失败，请检查进程权限。`); }
+  // taskkill can report before handles disappear; keep verification bounded.
+  for (let attempt = 0; attempt < 20; attempt++) {
+    if (!processExists(pid)) return;
+    await new Promise<void>((resolve) => setTimeout(resolve, 50));
+  }
+  throw new Error(`无法确认进程树 ${pid} 已终止，进程仍存在。`);
+}
diff --git a/member-agent/src/protocol.ts b/member-agent/src/protocol.ts
new file mode 100644
index 0000000..1632504
--- /dev/null
+++ b/member-agent/src/protocol.ts
@@ -0,0 +1,164 @@
+import type { Accounting, ExecutorResult } from "./executors/types.ts";
+export type { JobStart } from "./executors/types.ts";
+
+export const MAX_FRAME_BYTES = 256 * 1024;
+export const MAX_LOG_BYTES = 32 * 1024;
+
+export interface Frame {
+  v: 1;
+  type: string;
+  [key: string]: unknown;
+}
+
+export interface InvocationMeta {
+  adapterType: string;
+  command: string;
+  cwd?: string;
+  commandArgs?: string[];
+  commandNotes?: string[];
+  env?: Record<string, string>;
+  prompt?: string;
+  promptMetrics?: Record<string, number>;
+  context?: Record<string, unknown>;
+}
+
+export interface RuntimeEvent {
+  eventType: string;
+  stream?: "system" | "stdout" | "stderr";
+  level?: "info" | "warn" | "error";
+  color?: string;
+  message?: string;
+  payload?: Record<string, unknown>;
+}
+
+export interface UsageCheckpoint extends Accounting {
+  attemptId?: string;
+  complete: boolean;
+}
+
+type Check = (value: unknown) => boolean;
+type Shape = Record<string, Check>;
+const string: Check = (value) => typeof value === "string";
+const boolean: Check = (value) => typeof value === "boolean";
+const number: Check = (value) => typeof value === "number" && Number.isFinite(value) && value >= 0;
+const integer: Check = (value) => typeof value === "number" && Number.isSafeInteger(value);
+const optional = (check: Check): Check => (value) => value === undefined || check(value);
+const nullable = (check: Check): Check => (value) => value === null || check(value);
+const literal = (expected: unknown): Check => (value) => value === expected;
+const oneOf = (...values: string[]): Check => (value) => typeof value === "string" && values.includes(value);
+const array = (check: Check): Check => (value) => Array.isArray(value) && value.every(check);
+const isRecord = (value: unknown): value is Record<string, unknown> => value !== null && typeof value === "object" && !Array.isArray(value);
+const record = (check: Check = () => true): Check => (value) => {
+  if (!isRecord(value)) return false;
+  // z.record accepts plain records, unlike z.object (which also accepts class
+  // instances); match its constructor check without importing server code.
+  const constructor = value.constructor;
+  if (typeof constructor === "function" && (!isRecord(constructor.prototype) || !Object.hasOwn(constructor.prototype, "isPrototypeOf"))) return false;
+  return Reflect.ownKeys(value).every((key) => key === "__proto__" || !Object.prototype.propertyIsEnumerable.call(value, key)
+    || (typeof key === "string" && check(value[key])));
+};
+const object = (shape: Shape): Check => (value) => isRecord(value)
+  && Object.keys(value).every((key) => Object.hasOwn(shape, key))
+  && Object.entries(shape).every(([key, check]) => check(Object.hasOwn(value, key) ? value[key] : undefined));
+
+const usage = object({ inputTokens: number, outputTokens: number, cachedInputTokens: optional(number), cacheWriteTokens: optional(number) });
+const contextTier = oneOf("short", "long");
+const accounting: Shape = {
+  usage: optional(usage),
+  usageByModel: optional(array(object({ model: string, usage, costUsd: number }))),
+  usageBasis: optional(nullable(oneOf("per_run", "session_cumulative"))),
+  provider: optional(nullable(string)), biller: optional(nullable(string)), model: optional(nullable(string)),
+  billingType: optional(nullable(oneOf("api", "subscription", "metered_api", "subscription_included", "subscription_overage", "credits", "fixed", "unknown"))),
+  costUsd: optional(nullable(number)), costUsdExact: optional(nullable(string)),
+  costStatus: optional(oneOf("reported", "estimated", "unpriced")),
+  pricingContext: optional(object({ serviceTier: optional(string), contextTier: optional(contextTier) })),
+  pricingProvenance: optional(object({
+    source: oneOf("provider_reported", "provider_invoice", "operator", "rate_card", "unknown"),
+    version: optional(string), evidence: optional(string), inputCentsPerMillion: optional(string),
+    cachedInputCentsPerMillion: optional(string), outputCentsPerMillion: optional(string),
+    cacheWriteCentsPerMillion: optional(string), serviceTier: optional(string), contextTier: optional(contextTier),
+  })),
+  cacheAdjustedCostUsd: optional(nullable(number)), providerRequestId: optional(nullable(string)),
+};
+
+// Match z.iso.datetime({ offset: true }): calendar-valid dates, optional seconds,
+// arbitrary fractional precision, and only Z or an explicit ±HH:MM offset.
+const isoDateTime: Check = (value) => {
+  if (typeof value !== "string") return false;
+  const match = /^(\d{4})-(\d{2})-(\d{2})T(?:[01]\d|2[0-3]):[0-5]\d(?::[0-5]\d(?:\.\d+)?)?(?:Z|[+-](?:[01]\d|2[0-3]):[0-5]\d)$/.exec(value);
+  if (!match) return false;
+  const year = Number(match[1]), month = Number(match[2]), day = Number(match[3]);
+  const leap = year % 4 === 0 && (year % 100 !== 0 || year % 400 === 0);
+  const days = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+  return month >= 1 && month <= 12 && day >= 1 && day <= days[month - 1]!;
+};
+const executionRecovery: Check = (value) => object({ kind: literal("bootstrap"), providerWorkStarted: literal(false) })(value)
+  || object({ kind: literal("interrupted"), providerStopped: literal(true), sessionPreserved: literal(true), actionOutcomes: literal("settled") })(value);
+const result = object({
+  ...accounting, exitCode: nullable(integer), signal: nullable(string), timedOut: boolean,
+  errorCode: optional(nullable(string)), errorMessage: optional(nullable(string)),
+  errorFamily: optional(nullable(oneOf("configuration", "transient_upstream", "provider_quota", "model_refusal", "refresh_token_reused", "refresh_token_expired", "refresh_token_invalidated"))),
+  retryNotBefore: optional(nullable(isoDateTime)), errorMeta: optional(record()),
+  summary: optional(nullable(string)), resultJson: optional(nullable(record())),
+  sessionId: optional(nullable(string)), sessionDisplayId: optional(nullable(string)), sessionParams: optional(nullable(record())),
+  clearSession: optional(boolean), usageComplete: optional(boolean), executionRecovery: optional(executionRecovery),
+});
+const meta = object({
+  adapterType: string, command: string, cwd: optional(string), commandArgs: optional(array(string)), commandNotes: optional(array(string)),
+  env: optional(record(string)), prompt: optional(string), promptMetrics: optional(record(number)), context: optional(record()),
+});
+const event = object({
+  eventType: string, stream: optional(oneOf("system", "stdout", "stderr")), level: optional(oneOf("info", "warn", "error")),
+  color: optional(string), message: optional(string), payload: optional(record()),
+});
+const checkpoint = object({ ...accounting, attemptId: optional(string), complete: boolean });
+
+function validated<T>(value: unknown, check: Check, message: string): T {
+  if (!check(value)) throw new Error(message);
+  return value as T;
+}
+
+/** Never include raw input in protocol errors: frames can contain credentials. */
+export function parseFrame(bytes: Buffer | string, binary = false): Frame {
+  if (binary) throw new Error("协议错误：只接受 UTF-8 文本帧");
+  if (Buffer.byteLength(bytes) > MAX_FRAME_BYTES) throw new Error("协议错误：消息超过 256 KB");
+  let value: unknown;
+  try {
+    const text = typeof bytes === "string" ? bytes : new TextDecoder("utf-8", { fatal: true }).decode(bytes);
+    value = JSON.parse(text);
+  } catch {
+    throw new Error("协议错误：消息不是有效的 UTF-8 JSON");
+  }
+  if (!isRecord(value) || value.v !== 1 || typeof value.type !== "string") throw new Error("协议错误：消息必须包含 v: 1 和字符串 type");
+  return value as Frame;
+}
+
+export function validateResult(value: unknown): ExecutorResult {
+  return validated(value, result, "协议错误：运行结果含未知字段或字段无效");
+}
+
+export function validateMeta(value: unknown): InvocationMeta {
+  return validated(value, meta, "协议错误：调用元数据含未知字段或字段无效");
+}
+
+export function validateEvent(value: unknown): RuntimeEvent {
+  return validated(value, event, "协议错误：运行事件含未知字段或字段无效");
+}
+
+export function validateUsage(value: unknown): UsageCheckpoint {
+  return validated(value, checkpoint, "协议错误：用量消息含未知字段或字段无效");
+}
+
+export function chunkUtf8(text: string, maxBytes = MAX_LOG_BYTES): string[] {
+  if (!Number.isSafeInteger(maxBytes) || maxBytes < 1) throw new Error("日志分块字节上限必须是正整数");
+  const chunks: string[] = [];
+  let pending: string[] = [], size = 0;
+  for (const character of text) {
+    const bytes = Buffer.byteLength(character);
+    if (bytes > maxBytes) throw new Error("日志分块字节上限无法容纳一个完整字符");
+    if (size + bytes > maxBytes) { chunks.push(pending.join("")); pending = []; size = 0; }
+    pending.push(character); size += bytes;
+  }
+  if (pending.length) chunks.push(pending.join(""));
+  return chunks;
+}
