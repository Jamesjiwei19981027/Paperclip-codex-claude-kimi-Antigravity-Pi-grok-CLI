+      cwd,
+      timeoutSec: hooks.job.config.maxRunSec ?? 3600,
+      graceSec: 20,
+      env: { CODEX_HOME: home, ...buildRuntimeToolEnv(hooks.job, hooks.serverUrl) },
+      extraArgs: [],
