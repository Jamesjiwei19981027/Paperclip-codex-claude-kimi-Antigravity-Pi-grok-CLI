+    },
+    context: localized.context,
+    executionTarget: { kind: "local" },
+    authToken: hooks.job.authToken,
+    getFreshSessionHandoff: async () => hooks.job.handoffMarkdown.trim() ? hooks.job.handoffMarkdown : null,
+    onLog: hooks.log,
