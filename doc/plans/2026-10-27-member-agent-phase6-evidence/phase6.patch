+    if (!$TestMode) { $task = Get-ScheduledTask -TaskName 'PaperclipMemberAgent' -ErrorAction SilentlyContinue; if ($task) { Unregister-ScheduledTask -TaskName 'PaperclipMemberAgent' -Confirm:$false } }
