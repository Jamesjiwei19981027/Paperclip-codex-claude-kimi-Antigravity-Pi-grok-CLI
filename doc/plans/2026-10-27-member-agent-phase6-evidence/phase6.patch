+}
+try {
+    if (!$TestMode -and ($TestExecutor -or $TestNode -or $TestDefaultCwd -or $TestOverwrite -or $TestReplaceConfig -or $PSBoundParameters.ContainsKey('TestServerUrl'))) { throw 'Test 参数仅限显式测试模式。' }
