+    if (!$process.CommandLine.Contains((Join-Path $RootPath 'versions')) -or !$process.CommandLine.Contains((Join-Path $ConfigPath 'config.json')) -or $process.CommandLine -notmatch 'main\.ts[" ]+run(?:\s|$)') { return $null }
