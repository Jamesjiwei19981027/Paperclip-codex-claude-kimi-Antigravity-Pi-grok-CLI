+    if ($deleteConfig) { $targets += (Join-Path $ConfigDir 'config.json'); $targets += (Join-Path $ConfigDir 'agent-key.dpapi') }
+    if ($deleteHome) { $targets += (Join-Path $ConfigDir 'codex-home') }
+    if ($deleteLogs) { $targets += (Join-Path $ConfigDir 'logs') }
